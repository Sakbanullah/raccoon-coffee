// Raccoon Coffee - Database schema
// Source of truth: docs/raccoon-database-architecture.md
// Do not add entities, fields, or relations outside that document.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Admin {
  adminId      String   @id @default(uuid()) @map("admin_id") @db.Char(36)
  name         String   @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime()

  photoUploads PhotoUpload[]

  @@map("admin")
}

model Branch {
  branchId    String    @id @default(uuid()) @map("branch_id") @db.Char(36)
  name        String    @unique @db.VarChar(255)
  address     String    @db.VarChar(255)
  city        String    @db.VarChar(255)
  province    String    @db.VarChar(255)
  postalCode  String?   @map("postal_code") @db.VarChar(20)
  latitude    Decimal?  @db.Decimal(9, 6)
  longitude   Decimal?  @db.Decimal(9, 6)
  openingTime DateTime? @map("opening_time") @db.Time()
  closingTime DateTime? @map("closing_time") @db.Time()
  phone       String?   @db.VarChar(50)
  mapsUrl     String?   @map("maps_url") @db.VarChar(500)
  isActive    Boolean   @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.DateTime()

  products     Product[]
  stories      Story[]
  events       Event[]
  photoUploads PhotoUpload[]

  @@map("branch")
}

model ProductCategory {
  categoryId   String   @id @default(uuid()) @map("category_id") @db.Char(36)
  name         String   @unique @db.VarChar(255)
  slug         String   @unique @db.VarChar(255)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime()

  products Product[]

  @@map("product_category")
}

model Product {
  productId    String        @id @default(uuid()) @map("product_id") @db.Char(36)
  categoryId   String        @map("category_id") @db.Char(36)
  branchId     String?       @map("branch_id") @db.Char(36)
  name         String        @db.VarChar(255)
  slug         String        @unique @db.VarChar(255)
  description  String?       @db.Text
  price        Decimal       @db.Decimal(10, 2)
  imageUrl     String?       @map("image_url") @db.VarChar(500)
  status       ProductStatus @default(ACTIVE)
  displayOrder Int           @default(0) @map("display_order")
  createdAt    DateTime      @default(now()) @map("created_at") @db.DateTime()
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.DateTime()

  category ProductCategory @relation(fields: [categoryId], references: [categoryId])
  branch   Branch?         @relation(fields: [branchId], references: [branchId])

  @@index([categoryId])
  @@index([branchId])
  @@index([status])
  @@index([displayOrder])
  @@map("product")
}

model Story {
  storyId       String        @id @default(uuid()) @map("story_id") @db.Char(36)
  branchId      String?       @map("branch_id") @db.Char(36)
  title         String        @db.VarChar(255)
  slug          String        @unique @db.VarChar(255)
  content       String        @db.Text
  coverImageUrl String?       @map("cover_image_url") @db.VarChar(500)
  status        ContentStatus @default(DRAFT)
  publishedAt   DateTime?     @map("published_at") @db.DateTime()
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.DateTime()

  branch Branch? @relation(fields: [branchId], references: [branchId])

  @@index([branchId])
  @@index([status])
  @@index([publishedAt])
  @@map("story")
}

model Event {
  eventId       String        @id @default(uuid()) @map("event_id") @db.Char(36)
  branchId      String?       @map("branch_id") @db.Char(36)
  title         String        @db.VarChar(255)
  slug          String        @unique @db.VarChar(255)
  description   String        @db.Text
  coverImageUrl String?       @map("cover_image_url") @db.VarChar(500)
  eventDate     DateTime      @map("event_date") @db.Date
  startTime     DateTime?     @map("start_time") @db.Time()
  endTime       DateTime?     @map("end_time") @db.Time()
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.DateTime()

  branch Branch? @relation(fields: [branchId], references: [branchId])

  @@index([branchId])
  @@index([status])
  @@index([eventDate])
  @@map("event")
}

model PhotoUpload {
  photoId           String      @id @default(uuid()) @map("photo_id") @db.Char(36)
  branchId          String?     @map("branch_id") @db.Char(36)
  reviewedByAdminId String?     @map("reviewed_by_admin_id") @db.Char(36)
  visitorName       String      @map("visitor_name") @db.VarChar(255)
  caption           String?     @db.Text
  imageUrl          String      @map("image_url") @db.VarChar(500)
  thumbnailUrl      String?     @map("thumbnail_url") @db.VarChar(500)
  originalFilename  String?     @map("original_filename") @db.VarChar(255)
  mimeType          String?     @map("mime_type") @db.VarChar(100)
  fileSize          BigInt?     @map("file_size")
  status            PhotoStatus @default(PENDING)
  moderationNote    String?     @map("moderation_note") @db.Text
  createdAt         DateTime    @default(now()) @map("created_at") @db.DateTime()
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.DateTime()
  reviewedAt        DateTime?   @map("reviewed_at") @db.DateTime()

  branch     Branch? @relation(fields: [branchId], references: [branchId])
  reviewedBy Admin?  @relation(fields: [reviewedByAdminId], references: [adminId])

  @@index([branchId])
  @@index([status])
  @@index([createdAt])
  @@index([reviewedByAdminId])
  @@map("photo_upload")
}
