# Raccoon Coffee — Nginx TEMPORARY bootstrap site (HTTP only, no TLS yet)
#
# Purpose: serve the Certbot webroot challenge and keep the site valid BEFORE a
# certificate exists. `raccoon-nginx.conf.example` references certificate files
# in /etc/letsencrypt/live/<domain>/, so installing it first makes `nginx -t`
# fail. Install this file first, obtain the certificate, then replace it with
# the final HTTPS site file.
#
# Install:
#   sudo install -d -o root -g root -m 755 /var/www/html
#   sudo cp raccoon-nginx-bootstrap.conf /etc/nginx/sites-available/raccoon.conf
#   sudo ln -sfn /etc/nginx/sites-available/raccoon.conf /etc/nginx/sites-enabled/raccoon.conf
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot certonly --webroot -w /var/www/html -d <domain>
#   # then install raccoon-nginx.conf (HTTPS) and reload Nginx
#
# Temporary limits: this serves the app over plain HTTP. Secure cookies are not
# sent over HTTP, so admin login will not work until HTTPS is enabled. Do not
# leave this file in place on a production server.
#
# Replace <domain> with the real hostname on the server. Never commit a real
# domain, certificate, or key.

server {
    listen 80;
    listen [::]:80;
    server_name <domain>;

    # Certbot webroot challenge must stay reachable over plain HTTP.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # API uploads are capped at 5 MB; 6 MB leaves room for multipart overhead.
    client_max_body_size 6m;

    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_read_timeout 60s;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 60s;
    }
}
