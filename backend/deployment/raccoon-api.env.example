# Raccoon Coffee backend — systemd environment file TEMPLATE
#
# Copy this file to /etc/raccoon/raccoon-api.env on the server, fill in real
# values, then:  sudo chmod 600 /etc/raccoon/raccoon-api.env
# (owned by root, readable only by root — systemd loads it before dropping
# privileges to the service user, so the service itself never needs to read it
# as anything other than its process environment.)
#
# NEVER commit a filled-in copy of this file. Keep it outside the repository.

# --- Required -------------------------------------------------------------

# Must be exactly "production" on the server. It enables Secure cookies and
# skips the local backend/.env loader. That loader is lazy and guarded, so a
# missing `dotenv` devDependency after `npm prune --omit=dev` only logs a
# warning; it does not crash the API with MODULE_NOT_FOUND.
NODE_ENV=production

# Port the API listens on (matches the Nginx site template).
PORT=3001

# MySQL/MariaDB connection string. Replace <user>, <password>, <host>, <db>.
# Prefer a local socket-adjacent setup (127.0.0.1) or the DB host you provisioned.
DATABASE_URL=mysql://<user>:<password>@<host>:3306/<db>

# JWT signing secret. REQUIRED in every environment.
# Generate: openssl rand -base64 32
# Must be at least 32 characters and not a known placeholder.
JWT_SECRET=<paste-generated-secret-here>

# --- Recommended in production --------------------------------------------

# Number of reverse-proxy hops in front of the API. 1 behind a single Nginx.
# Required in production when traffic arrives through a proxy; rate limiting
# otherwise sees only the proxy's IP.
TRUST_PROXY=1

# Absolute path for uploaded images. The API creates it at startup, but create
# it before starting the unit: systemd ReadWritePaths= requires the path to
# exist. The service user needs read/write access to it. Matches README.md.
UPLOAD_DIR=/var/lib/raccoon/uploads

# --- Optional -------------------------------------------------------------

# Interface the API binds to. Defaults to 127.0.0.1 (loopback only, Nginx is the
# only client). Set another address only when the API must be reached remotely.
# HOST=127.0.0.1

# SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD are for the local/demo seed only
# (`npm run seed`) and insert demo content. They are NOT a production admin
# bootstrap path: do not put them in this file. Use `npm run admin:bootstrap`
# from an interactive terminal instead; it prompts for the admin password and
# never reads it from the environment or the command line.
