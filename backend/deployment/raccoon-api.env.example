# Raccoon Coffee backend — systemd environment file TEMPLATE
#
# Copy this file to /etc/raccoon/raccoon-api.env on the server, fill in real
# values, then:  sudo chmod 600 /etc/raccoon/raccoon-api.env
# (owned by root, readable only by root — systemd loads it before dropping
# privileges to the service user, so the service itself never needs to read it
# as anything other than its process environment.)
#
# NEVER commit a filled-in copy of this file. Keep it outside the repository.

# --- Required -------------------------------------------------------------

# production enables Secure cookies. Must be exactly "production" on the server.
NODE_ENV=production

# Port the API listens on. Choose one; the Nginx site proxies to it.
PORT=<port>

# MySQL/MariaDB connection string. Replace <user>, <password>, <host>, <db>.
# Prefer a local socket-adjacent setup (127.0.0.1) or the DB host you provisioned.
DATABASE_URL=mysql://<user>:<password>@<host>:3306/<db>

# JWT signing secret. REQUIRED in every environment.
# Generate: openssl rand -base64 32
# Must be at least 32 characters and not a known placeholder.
JWT_SECRET=<paste-generated-secret-here>

# --- Recommended in production --------------------------------------------

# Number of reverse-proxy hops in front of the API. 1 behind a single Nginx.
# Required in production when traffic arrives through a proxy; rate limiting
# otherwise sees only the proxy's IP.
TRUST_PROXY=1

# Absolute path for uploaded images. The directory is created at startup;
# the service user needs read/write access to it.
UPLOAD_DIR=<absolute-upload-directory>

# --- Optional -------------------------------------------------------------
# SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD are used only by `npm run seed`
# for the FIRST admin. Do not put them in this file; run the seed manually
# with a temporary environment if ever needed.
