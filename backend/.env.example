# Copy to backend/.env (local) or set in the host's environment (production).
# Never commit real values.

# development | production. Production enables Secure cookies. Required.
# Note: JWT_SECRET is required in EVERY environment (there is no dev fallback),
# so a missing/misspelled NODE_ENV can never weaken JWT signing.
NODE_ENV=

# HTTP port the API listens on. Default 3001.
PORT=

# MySQL/MariaDB connection string for Prisma. Format: mysql://USER:PASSWORD@HOST:3306/raccoon
DATABASE_URL=

# JWT signing secret for admin login. REQUIRED in every environment — the app
# refuses to start if it is missing, shorter than 32 characters, or a known
# placeholder/default value (e.g. super-secret-raccoon-key). Never commit a real
# secret and never reuse one across environments.
#
# Generate a strong value (32 random bytes, base64url) and paste the output:
#   openssl rand -base64 32
# PowerShell equivalent:
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
#
# Set it in backend/.env for local development, or in the host environment
# (e.g. systemd EnvironmentFile= with chmod 600) for production. dotenv never
# overrides an already-set environment variable, so the real environment wins.
JWT_SECRET=

# Absolute path where uploaded images are stored. Default ./uploads (relative to working dir).
UPLOAD_DIR=

# Number of reverse-proxy hops in front of the API (e.g. 1 behind one Nginx or Render).
# Leave empty if no proxy. Affects client IP detection for rate limiting.
TRUST_PROXY=

# First-admin bootstrap, used ONLY by `npm run seed`. Leave BOTH empty on normal
# runs and after the first admin exists — seeding never overwrites an existing
# admin's password. Set BOTH (only for the first seed) to create the admin.
# Use a strong, operator-chosen password. Never commit real values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Display name for the bootstrapped admin. Optional; defaults to "Admin".
SEED_ADMIN_NAME=
